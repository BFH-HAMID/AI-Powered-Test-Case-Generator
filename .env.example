# FastAPI & General Settings
APP_NAME="AI-Powered Test Case Generator"
APP_ENV="development"
LOG_LEVEL="INFO"
API_HOST="0.0.0.0"
API_PORT=8000
BACKEND_URL="http://127.0.0.1:8000"

# Security & Auth
# Leave API_KEY empty in development to allow unauthenticated local UI calls, or set a secret key for production
API_KEY=""
GITHUB_WEBHOOK_SECRET="dev-webhook-secret-change-me"

# Database (SQLite default, supports PostgreSQL e.g. postgresql+psycopg2://user:pass@host:5432/dbname)
DATABASE_URL="sqlite:///./ai_test_gen.db"

# LLM Configuration
# Supported providers: openai, anthropic, ollama, local-synthesizer
LLM_PROVIDER="local-synthesizer"
LLM_MODEL="gpt-4o"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Sandbox & Validation Settings
SANDBOX_MODE="docker"
SANDBOX_DOCKER_IMAGE="ai-test-sandbox:latest"
SANDBOX_DOCKER_IMAGE_JS="ai-test-sandbox-js:latest"
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT_MB=256
SANDBOX_CPU_LIMIT=1.0
MAX_ITERATIONS_DEFAULT=3
NODE_TIMEOUT_SECONDS=180

# File System & Git Integration
ALLOWED_TEST_DIR="tests/generated"
GIT_REPO_PATH=""
GIT_ISOLATED_WORKSPACE=""
GITHUB_TOKEN=""
GITHUB_DEFAULT_REPO=""
GITHUB_DEFAULT_BRANCH="main"

# Optional S3 storage for durable generated test artifacts (recommended in AWS Lambda)
ARTIFACT_BUCKET=""
ARTIFACT_PREFIX="generated-tests"

# Optional AWS Fargate sandbox runner (required for dry-runs in Lambda)
ECS_CLUSTER_ARN=""
ECS_TASK_DEFINITION_ARN=""
ECS_SUBNETS=""
ECS_SECURITY_GROUP_ID=""
ECS_CONTAINER_NAME="test-sandbox"
ECS_TASK_TIMEOUT_SECONDS=300
